{
  "name": "poke-lives",
  "version": "1.0.0",
  "description": "Poke Lives",
  "license": "MIT",
  "author": "dgomes04",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgomes04/poke-lives.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.pokelives.app",
    "productName": "Poke Lives",
    "icon": "build/icon.png",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "build/icon.png",
      "!build/make-icon.js",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Poke Lives"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
